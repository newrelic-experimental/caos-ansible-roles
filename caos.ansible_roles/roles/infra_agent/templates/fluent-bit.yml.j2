# Default New Relic logging (embedded Fluent Bit) configuration for the
# containerized Infra Agent. Mounted into /etc/newrelic-infra/logging.d/.
# The agent supplies the New Relic output plugin + license key itself, so this
# file only defines the log source. Override by pointing `fluent_bit_config`
# at your own template/file.
#
# Paths are relative to the container; host / is mounted read-only at /host,
# so host /var/log/*.log is /host/var/log/*.log inside the container.
logs:
  - name: var-log
    file: /host/var/log/*.log
    attributes:
      logtype: var-log
