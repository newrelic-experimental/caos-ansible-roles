# Fluent Bit configuration for the standalone newrelic/newrelic-fluentbit-output
# container. The image bundles Fluent Bit + the New Relic output plugin
# (out_newrelic.so), so this file only defines the input source and the
# New Relic output. LICENSE_KEY and ENDPOINT are supplied as env vars.
[SERVICE]
    Flush        1
    Log_Level    info
    Daemon       off

# Host logs from the systemd journal (Ubuntu 24.04 logs to journald, not files).
# The systemd input reads the journal files directly, so it needs the host
# journal dir mounted in - no systemctl/journalctl binary required.
[INPUT]
    Name               systemd
    Tag                host.*
    Read_From_Tail     On
    Strip_Underscores  On

# Stamp every record with the agent version this forwarder belongs to, so logs
# from the side-by-side canary containers can be told apart in New Relic
# (e.g. `WHERE fb_source = '{{ target_agent_version_or_latest }}'`).
[FILTER]
    Name    modify
    Match   host.*
    Add     fb_source  {{ target_agent_version_or_latest }}

[OUTPUT]
    Name         nrlogs
    Match        *
    license_key  ${LICENSE_KEY}
    base_uri     ${ENDPOINT}
